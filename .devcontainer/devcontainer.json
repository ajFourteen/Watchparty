{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installGradle": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    // Fuer ci/pipeline-beobachten.sh und den Blick auf Actions-Laeufe.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Reicht ein auf dem Host gesetztes GH_TOKEN in den Container durch.
  // Ohne Token gilt fuer die GitHub-API ein Limit von 60 Anfragen je Stunde;
  // der Pipeline-Beobachter pollt dann seltener, damit ein laufender Deploy
  // nicht mittendrin ins Limit faellt. Ist die Variable auf dem Host nicht
  // gesetzt, bleibt sie hier leer -- das ist kein Fehler, nur langsamer.
  // Noetig ist ein Fine-grained-Token mit Leserecht auf "Actions" dieses
  // Repos; mehr braucht weder gh noch das Skript.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  }
}
