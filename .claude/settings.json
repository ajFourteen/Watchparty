{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/git-regeln-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Git-Regeln pruefen"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/pipeline-beobachten.sh\"",
            "asyncRewake": true,
            "timeout": 1800,
            "statusMessage": "Pipeline beobachten",
            "rewakeMessage": "Die Pipeline zu diesem Push ist rot. Befund des Beobachters:",
            "rewakeSummary": "Pipeline fehlgeschlagen"
          }
        ]
      }
    ]
  }
}
