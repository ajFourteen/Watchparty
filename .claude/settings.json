{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/sitzungsstart.sh\"",
            "timeout": 15,
            "statusMessage": "Arbeitsstand und offene Entscheidungen einlesen"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/git-regeln-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Git-Regeln pruefen"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/pipeline-beobachten.sh\"",
            "asyncRewake": true,
            "timeout": 1800,
            "statusMessage": "Pipeline beobachten",
            "rewakeMessage": "Rueckmeldung des Pipeline-Beobachters zu diesem Push:",
            "rewakeSummary": "Pipeline beobachtet"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/ci/stop-arbeit-abschliessen.sh\"",
            "timeout": 30,
            "statusMessage": "Arbeitsbaum pruefen"
          }
        ]
      }
    ]
  }
}
